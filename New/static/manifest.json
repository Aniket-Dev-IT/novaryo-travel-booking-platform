  "screenshots": [
    {
      "src": "/static/images/screenshots/desktop-home.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Novaryo Home Page - Desktop"
    },
    {
      "src": "/static/images/screenshots/mobile-home.png",
      "sizes": "360x640",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Novaryo Home Page - Mobile"
    },
    {
      "src": "/static/images/screenshots/loyalty-dashboard.png",
      "sizes": "360x640",
      "type": "image/png",
