    },
    {
      "src": "/static/images/screenshots/flight-search.png",
      "sizes": "360x640",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Flight Search"
    }
  ],
  "categories": ["travel", "business", "lifestyle"],
  "shortcuts": [
    {
      "name": "Search Flights",
      "short_name": "Flights",
      "description": "Find and book flights",
      "url": "/flights/search",
      "icons": [
        {
          "src": "/static/images/shortcuts/flight-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Find Hotels",
      "short_name": "Hotels", 
      "description": "Search and book hotels",
      "url": "/hotels/search",
      "icons": [
        {
          "src": "/static/images/shortcuts/hotel-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Loyalty Dashboard",
      "short_name": "Loyalty",
      "description": "View points and rewards",
      "url": "/loyalty/",
      "icons": [
        {
          "src": "/static/images/shortcuts/loyalty-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "My Bookings",
      "short_name": "Bookings",
      "description": "View and manage bookings",
      "url": "/bookings/",
      "icons": [
        {
          "src": "/static/images/shortcuts/booking-icon.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.novaryo.app",
      "id": "com.novaryo.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/novaryo/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/contact?email=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  }
}